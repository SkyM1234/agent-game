# Use the existing llm Python environment. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official API currently accepts this alias and routes it to V4.1 Flash.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.5
DEEPSEEK_MAX_CONSECUTIVE_FAILURES=3

# Optional. Without this setting, the journal uses data/index.sqlite3.
# The database is created automatically; URL-encode special characters in credentials.
ARENA_DATABASE_URL=mysql+pymysql://arena:password@127.0.0.1:3306/agent_arena
